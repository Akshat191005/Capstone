{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true,
    "headerText": "InvestIQ - Autonomous Multi-Agent System for Financial Consensus and Risk-Weighted Investment Advisory",
    "fileSummary": true,
    "directoryStructure": true,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 5
  },
  "include": [
    "**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/venv/**",
      "**/.venv/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/*.pyc",
      "**/package-lock.json",
      "repomix-output.*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
