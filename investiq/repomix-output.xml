  flex-direction: column;
  justify-content: center;
  padding: 80px 0 60px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 16px;
  background: rgba(0, 212, 255, 0.08);
  border: 1px solid rgba(0, 212, 255, 0.2);
  border-radius: 50px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--accent-cyan);
  letter-spacing: 0.5px;
  margin-bottom: 24px;
}

.hero-badge .dot {
  width: 6px;
  height: 6px;
  background: var(--accent-green);
  border-radius: 50%;
  animation: pulse-glow 2s ease-in-out infinite;
  box-shadow: 0 0 6px var(--accent-green);
}

.hero-title {
  font-size: clamp(3rem, 7vw, 5.5rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -2px;
  margin-bottom: 24px;
}

.hero-title .gradient-text {
  background: var(--gradient-brand);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-description {
  font-size: 1.15rem;
  color: var(--text-secondary);
  max-width: 580px;
  line-height: 1.75;
  margin-bottom: 40px;
}

.hero-actions {
  display: flex;
  gap: 16px;
  align-items: center;
  flex-wrap: wrap;
}

.hero-stats {
  display: flex;
  gap: 40px;
  margin-top: 64px;
  padding-top: 40px;
  border-top: 1px solid var(--border-card);
}

.hero-stat-value {
  font-family: 'Outfit', sans-serif;
  font-size: 2rem;
  font-weight: 800;
  background: var(--gradient-brand);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-stat-label {
  font-size: 0.82rem;
  color: var(--text-muted);
  margin-top: 2px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Ticker Bar */
.ticker-bar {
  background: rgba(0, 0, 0, 0.4);
  border-top: 1px solid var(--border-card);
  border-bottom: 1px solid var(--border-card);
  padding: 10px 0;
  overflow: hidden;
  position: relative;
}

.ticker-bar::before,
.ticker-bar::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 80px;
  z-index: 2;
}

.ticker-bar::before { left: 0; background: linear-gradient(to right, var(--bg-primary), transparent); }
.ticker-bar::after { right: 0; background: linear-gradient(to left, var(--bg-primary), transparent); }

.ticker-track {
  display: flex;
  gap: 48px;
  animation: ticker-scroll 30s linear infinite;
  width: max-content;
}

.ticker-item {
  display: flex;
  align-items: center;
  gap: 10px;
  white-space: nowrap;
  padding: 0 4px;
}

.ticker-symbol {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--text-secondary);
}

.ticker-price {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--text-primary);
}

.ticker-change {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.78rem;
  font-weight: 600;
}

.ticker-change.up { color: var(--signal-buy); }
.ticker-change.down { color: var(--signal-sell); }
.ticker-dot { width: 1px; height: 16px; background: var(--border-card); }

/* Market Cards Section */
.market-section {
