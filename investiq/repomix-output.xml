.consensus-signal.buy { color: var(--signal-buy); text-shadow: 0 0 40px rgba(0, 230, 118, 0.4); }
.consensus-signal.sell { color: var(--signal-sell); text-shadow: 0 0 40px rgba(255, 68, 68, 0.4); }
