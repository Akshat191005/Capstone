/* Loading skeleton */
.skeleton {
  background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.06) 50%, rgba(255,255,255,0.03) 75%);
  background-size: 400% 100%;
  animation: skeleton-shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-sm);
}

@keyframes skeleton-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* =============================================
   About Page
   ============================================= */
.about-page {
  padding: 64px 0 100px;
}

.about-hero {
  text-align: center;
  margin-bottom: 80px;
}

.pipeline-section {
  margin-bottom: 80px;
}

.pipeline {
  display: flex;
  gap: 0;
  margin-top: 48px;
  position: relative;
  overflow-x: auto;
  padding-bottom: 16px;
}

.pipeline::before {
  content: '';
  position: absolute;
  top: 40px;
  left: 80px;
  right: 80px;
  height: 1px;
  background: linear-gradient(to right, transparent, var(--border-glow), transparent);
}

.pipeline-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 16px;
  min-width: 130px;
}

.pipeline-icon {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.8rem;
  margin-bottom: 16px;
  background: var(--bg-card);
  border: 1px solid var(--border-glow);
  box-shadow: var(--shadow-glow-cyan);
  position: relative;
  z-index: 1;
  transition: all 0.3s ease;
}

.pipeline-step:hover .pipeline-icon {
  transform: scale(1.1);
  box-shadow: 0 0 40px rgba(0, 212, 255, 0.3);
}

.pipeline-step-name {
  font-size: 0.9rem;
