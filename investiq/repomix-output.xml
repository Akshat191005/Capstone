  --faint: #A29C89;
  --border: #E9E1CF;
  --border-soft: #F1EBDC;
  --terracotta: #E1673D;
  --terracotta-dark: #C8532D;
  --purple: #8C7CE0;
  --blue: #4E8BE0;
  --teal: #2FA79A;
  --pink: #E066A0;
  --green: #1E9450;
  --green-bg: #E4F5EA;
  --amber: #C4841B;
  --amber-bg: #FBF0DC;
  --radius: 16px;
  --shadow: 0 1px 2px rgba(42,40,32,0.05), 0 14px 30px -16px rgba(42,40,32,0.18);
}

.landing-page {
  background: var(--bg);
  color: var(--ink);
  font-family: 'Inter', sans-serif;
  -webkit-font-smoothing: antialiased;
  line-height: 1.55;
  overflow-x: hidden;
}
