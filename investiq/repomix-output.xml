  margin-bottom: 4px;
}

.market-card-change {
  font-size: 0.85rem;
  font-weight: 600;
}

.market-card-change.up { color: var(--signal-buy); }
.market-card-change.down { color: var(--signal-sell); }

.market-chart-container {
  height: 90px;
  margin: 16px -4px 0;
}

.market-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--border-card);
}

.market-card-footer-label {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.market-card-footer-value {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-secondary);
  font-family: 'JetBrains Mono', monospace;
}

/* Features Section */
.features-section {
  padding: 80px 0;
  background: rgba(0, 0, 0, 0.2);
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
  margin-top: 48px;
}

.feature-card {
  padding: 28px;
}

.feature-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  margin-bottom: 20px;
  background: rgba(0, 212, 255, 0.1);
  border: 1px solid rgba(0, 212, 255, 0.2);
}

.feature-title {
  font-size: 1.05rem;
  font-weight: 700;
  margin-bottom: 10px;
  color: var(--text-primary);
}

.feature-desc {
  font-size: 0.88rem;
  color: var(--text-secondary);
  line-height: 1.65;
}

/* =============================================
   Analyze Page
   ============================================= */
.analyze-page {
  padding: 48px 0 80px;
}

.analyze-header {
  text-align: center;
  margin-bottom: 48px;
}

.search-bar {
  display: flex;
  gap: 12px;
  max-width: 620px;
  margin: 0 auto 16px;
}

.search-hint {
  text-align: center;
  font-size: 0.8rem;
  color: var(--text-muted);
}

.search-hint span {
  display: inline-flex;
  align-items: center;
  margin: 0 8px;
  padding: 2px 8px;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border-card);
  border-radius: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.75rem;
  color: var(--text-secondary);
}

/* Results */
.results-container {
  margin-top: 40px;
  animation: fadeInUp 0.5s ease;
}

.meta-consensus-card {
  padding: 36px;
  margin-bottom: 24px;
  background: linear-gradient(135deg, rgba(12, 18, 32, 0.95), rgba(8, 12, 24, 0.9));
  border: 1px solid var(--border-glow);
  box-shadow: var(--shadow-glow-cyan);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.meta-consensus-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: 50%;
  transform: translateX(-50%);
  width: 300px;
  height: 300px;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.06) 0%, transparent 70%);
}

.consensus-label {
  font-size: 0.75rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 12px;
  font-weight: 600;
}

.consensus-symbol {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1rem;
  color: var(--accent-cyan);
  margin-bottom: 16px;
  font-weight: 500;
}

.consensus-signal {
